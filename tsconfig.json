{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["DOM", "DOM.Iterable", "ES2025"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
